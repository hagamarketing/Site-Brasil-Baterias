---
import { beneficios } from '@/data/conteudo';

const faixa = ['Moura', 'Zetta', 'Heliar', 'Entrega grátis', 'Teste e instalação', 'Pague na entrega', 'Desde 1980', 'Marília - SP'];
---

<section aria-label="Vantagens da loja" class="relative py-6 lg:py-10">
  <div class="container-site">
    <dl class="border-line grid grid-cols-2 border-y lg:grid-cols-4">
      {
        beneficios.map((b) => (
          <div class="border-line flex flex-col gap-2 px-4 py-7 not-first:border-l max-lg:[&:nth-child(3)]:border-l-0 max-lg:nth-[n+3]:border-t sm:px-6 lg:px-8" data-reveal>
            <dt class="font-display text-accent text-3xl font-bold tracking-tight tabular-nums sm:text-4xl">
              <span
                data-count-to={b.valor}
                data-prefix={b.prefixo}
                data-suffix={b.sufixo}
                aria-label={b.rotulo}
              >
                {`${b.prefixo ?? ''}${b.valor}${b.sufixo ?? ''}`}
              </span>
            </dt>
            <dd class="text-muted text-sm leading-snug sm:text-base">{b.texto}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="mt-10 overflow-hidden whitespace-nowrap select-none" aria-hidden="true">
    <div class="animate-marquee flex w-max gap-10 [will-change:transform]">
      {
        [0, 1].map(() => (
          <div class="font-display text-fg/25 flex shrink-0 items-center gap-10 text-4xl font-bold tracking-tight uppercase sm:text-6xl">
            {faixa.map((t) => (
              <>
                <span>{t}</span>
                <span class="text-accent/60 text-2xl">✦</span>
              </>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
