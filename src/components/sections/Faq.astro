---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import { faq } from '@/data/conteudo';
---

<section id="duvidas" class="section-y relative" aria-labelledby="faq-titulo">
  <div class="container-site grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
    <div class="lg:sticky lg:top-[calc(var(--header-h)+3rem)] lg:self-start">
      <SectionHeading id="faq-titulo" rotulo="Dúvidas" titulo="Perguntas frequentes" />
    </div>

    <div class="divide-line border-line divide-y border-y">
      {
        faq.map((item, i) => (
          <details class="faq-item group" name="faq" open={i === 0} data-reveal="fade">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-left text-lg font-semibold sm:text-xl">
              {item.pergunta}
              <span class="faq-icon border-line-strong group-open:bg-accent grid size-9 shrink-0 place-items-center rounded-full border group-open:text-[#141826]">
                <Icon name="plus" size={18} />
              </span>
            </summary>
            <p class="text-muted max-w-2xl pb-7 leading-relaxed">{item.resposta}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
