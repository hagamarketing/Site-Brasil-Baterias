} as const;

export type IconName = keyof typeof paths;

interface Props {
  name: IconName;
  class?: string;
  size?: number;
  label?: string;
}

const { name, class: className, size = 20, label } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={paths[name]}
/>
